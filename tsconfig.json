{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "@types/bun"
    ],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "esModuleInterop": true,
    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "snoonu-ui",
    // Unreachable from the MCP entrypoints (verified by import-closure walk) and
    // referencing uninstalled packages (@anthropic-ai/claude-agent-sdk, valibot).
    // Left in place rather than deleted, but excluded so `tsc --noEmit` is
    // meaningful for the code that actually ships.
    "src/index.ts",
    "src/openrouter.ts",
    "src/agent",
    "src/lib/snoonu.ts"
  ]
}
