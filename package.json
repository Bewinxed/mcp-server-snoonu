{
  "name": "mcp-server-snoonu",
  "version": "0.3.0",
  "description": "MCP server for Snoonu (Qatar delivery) — search, cart, checkout, auth",
  "type": "module",
  "bin": {
    "mcp-server-snoonu": "dist/server.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "bun run src/mcp/server.ts",
    "dev:http": "bun run src/mcp/server-http.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "snoonu",
    "qatar",
    "delivery",
    "shopping",
    "claude"
  ],
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright": "^1.62.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/bun": "^1.3.14",
    "@types/node": "latest",
    "tsdown": "latest"
  }
}
